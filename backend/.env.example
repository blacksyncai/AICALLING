# Closer backend configuration — copy to `.env` and fill in what you have.
# Everything is optional; features unlock as keys are added (see /settings in the app).
# NEVER commit the real .env (it is gitignored).

# ── 1. Chat testing + the agent's brain + post-call analysis ─────────────────
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
ANALYSIS_MODEL=gpt-4.1-mini
# Any OpenAI-compatible endpoint (Azure, OpenRouter, Groq, …)
OPENAI_BASE_URL=https://api.openai.com/v1

# ── 2. Voice (browser test calls) ─────────────────────────────────────────────
# Free project at https://cloud.livekit.io → Settings → Keys
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Name the worker registers under; the API dispatches to it.
LIVEKIT_AGENT_NAME=pounce
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# ── 3. Phone calls + campaigns ────────────────────────────────────────────────
# A LiveKit outbound SIP trunk (e.g. Twilio Elastic SIP Trunking → LiveKit).
# Guide: https://docs.livekit.io/sip/quickstarts/configuring-twilio-trunk/
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=

# ── Optional: real calendar bookings (otherwise realistic mock slots) ─────────
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# ── Database ──────────────────────────────────────────────────────────────────
# Default: local SQLite file. For production use Postgres:
#   DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/closer
DATABASE_URL=sqlite+aiosqlite:///./closer.db

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
# Where the voice worker reaches this API (outcomes + transcripts are posted here).
WEBHOOK_BASE_URL=http://localhost:8000

# ── Legacy (original Pounce/Hemut flow) ───────────────────────────────────────
ORANGE_SLICE_API_KEY=
# Admin white label: actual custom-domain alias for the WEB service; blank disables domain activation.
WHITE_LABEL_CNAME_TARGET=
# Clerk only: set the same canonical HTTPS origin on the API and Next.js web service.
WHITE_LABEL_PRIMARY_ORIGIN=
